* text=auto eol=lf

# Checkpoints are distributed as Release assets, not in the repository.
# If you ever do decide to track them, Git LFS is mandatory — a single .pt is ~170 MB,
# above GitHub's 100 MB per-file limit.
*.pt  filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text

# Binary assets — do not attempt text diffs
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
